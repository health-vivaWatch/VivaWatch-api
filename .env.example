# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_KEY=my-secret-api-key

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgresql://vivawatch:vivawatch@localhost:5432/vivawatch

# ─── Redis ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── BullMQ ───────────────────────────────────────
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d

# ─── SendGrid ─────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vivawatch.com

# ─── Throttler ────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=debug
